# This file contains local properties like API keys
# Copy this file to local.properties and add your actual API keys
# local.properties is git-ignored so your keys won't be committed

# SDK location (this will be auto-generated by Android Studio)
sdk.dir=C:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk

# API Keys
# Get your Mistral API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenAI API key (currently disabled in the app due to security breach)
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud API key (for future features)
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Other configuration options can be added here as needed